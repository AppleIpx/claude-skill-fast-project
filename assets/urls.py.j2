from django.conf import settings
from django.conf.urls.static import static
from django.contrib import admin
{% if use_async %}
from django.contrib.staticfiles.urls import staticfiles_urlpatterns
{% endif %}
from django.urls import include, path
from django.views import defaults as default_views
{% if rest_api == "DRF" %}
from drf_spectacular.views import SpectacularAPIView, SpectacularSwaggerView
from rest_framework.authtoken.views import obtain_auth_token
{% endif %}
{% if use_wagtail %}
from wagtail.admin import urls as wagtailadmin_urls
from wagtail.documents import urls as wagtaildocs_urls
{% endif %}

from {{ slug }}.core.views import ping
{% if rest_api == "Django Ninja" %}

from .api import api
{% endif %}

# Every route lives under /api/: nginx sends /api to the backend, the rest to the frontend.
urlpatterns = [
    path("api/ping/", ping, name="ping"),
    # Django Admin
    path(f"api/{settings.ADMIN_URL}", admin.site.urls),
{% if use_wagtail %}
    # Wagtail: autocomplete must go before the admin catch-all
    path(f"api/{settings.WAGTAIL_ADMIN_URL}autocomplete/", include("wagtailautocomplete.urls.admin")),
    path(f"api/{settings.WAGTAIL_ADMIN_URL}", include(wagtailadmin_urls)),
    path("api/cms/documents/", include(wagtaildocs_urls)),
{% endif %}
    # Media files
    *static(settings.MEDIA_URL, document_root=settings.MEDIA_ROOT),
]
{% if use_async %}
if settings.DEBUG:
    # Static file serving when using Gunicorn + Uvicorn for local web socket development
    urlpatterns += staticfiles_urlpatterns()
{% endif %}
{% if rest_api == "DRF" %}

# API URLS
urlpatterns += [
    # API base url
    path("api/", include("config.api_router")),
    # DRF auth token
    path("api/auth-token/", obtain_auth_token, name="obtain_auth_token"),
    # Swagger is available to staff only (SPECTACULAR_SETTINGS["SERVE_PERMISSIONS"])
    path("api/schema/", SpectacularAPIView.as_view(), name="api-schema"),
    path(
        "api/docs/",
        SpectacularSwaggerView.as_view(url_name="api-schema"),
        name="api-docs",
    ),
]
{% elif rest_api == "Django Ninja" %}

# API URLS
urlpatterns += [
    # API base url
    path("api/", api.urls),
]
{% endif %}

if settings.DEBUG:
    # This allows the error pages to be debugged during development, just visit
    # these url in browser to see how these error pages look like.
    urlpatterns += [
        path(
            "api/400/",
            default_views.bad_request,
            kwargs={"exception": Exception("Bad Request!")},
        ),
        path(
            "api/403/",
            default_views.permission_denied,
            kwargs={"exception": Exception("Permission Denied")},
        ),
        path(
            "api/404/",
            default_views.page_not_found,
            kwargs={"exception": Exception("Page not Found")},
        ),
        path("api/500/", default_views.server_error),
    ]
    if "debug_toolbar" in settings.INSTALLED_APPS:
        import debug_toolbar

        urlpatterns = [
            path("api/__debug__/", include(debug_toolbar.urls)),
            *urlpatterns,
        ]
